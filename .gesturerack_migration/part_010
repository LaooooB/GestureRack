def main():
    repo = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path.cwd().resolve()
    raw = base64.b64decode(ZIP_B64.encode("ascii"))
    with tempfile.TemporaryDirectory(prefix="gesturerack-v4-") as td:
        td = Path(td)
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            zf.extractall(td)
        kit = td / "GestureRack-cross-platform-release-kit-v4"
        subprocess.check_call([sys.executable, str(kit / "verify_kit.py")])
        subprocess.check_call([sys.executable, str(kit / "apply_cross_platform_refactor.py"), str(repo)])

if __name__ == "__main__":
    main()
