"""

def main():
    repo=Path(sys.argv[1] if len(sys.argv)>1 else '.').resolve()
    with tempfile.TemporaryDirectory(prefix='gesturerack-v4-') as td:
        with zipfile.ZipFile(io.BytesIO(base64.b64decode(ZIP_B64))) as zf:
            zf.extractall(td)
        kit=Path(td)/'GestureRack-cross-platform-release-kit-v4'
        subprocess.run([sys.executable, str(kit/'verify_kit.py')], check=True, cwd=kit)
        subprocess.run([sys.executable, str(kit/'apply_cross_platform_refactor.py'), str(repo)], check=True, cwd=repo)
    subprocess.run([sys.executable, '-m', 'py_compile',
        str(repo/'release.py'), str(repo/'tools/release/pipeline.py'),
        str(repo/'VisionEngine/platform_camera.py'), str(repo/'VisionEngine/vision_runtime_io.py'),
        str(repo/'VisionEngine/vision_runtime_self_test.py'), str(repo/'VisionEngine/control_transport.py'),
        str(repo/'VisionEngine/frame_transport.py'), str(repo/'VisionEngine/local_broadcast.py')], check=True, cwd=repo)
    subprocess.run([sys.executable, str(repo/'release.py'), '--help'], check=True, cwd=repo)
    print('GestureRack v4 migration applied and verified.')

if __name__=='__main__':
    main()
